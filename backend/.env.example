GEMINI_API_KEY=your_gemini_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# OpenAI — Phase 1 (gpt-image-2 swap for tiers 1/2/3)
OPENAI_API_KEY=sk-proj-your_openai_key_here
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_TIMEOUT_S=180

# CORS — comma-separated list of allowed frontend origins.
# Leave unset in dev (defaults to localhost). Set in prod to your domain.
# ALLOWED_ORIGINS=https://arquivision.example.com,https://www.arquivision.example.com

# Daily per-user spend cap for OpenAI calls (USD). Owner is exempt.
# DAILY_USER_CAP_USD=25.0

# Set to true ONLY for local dev — bypasses Supabase JWT validation.
# SKIP_AUTH=false
